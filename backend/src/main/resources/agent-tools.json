  {
    "type": "function",
    "function": {
      "name": "project_plan",
      "description": "Planifie un projet : étapes, références et dépendances. Une confirmation est demandée si le plan touche plus de 10 éléments.",
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "goal", "deadline", "buffer_ratio", "steps"],
        "properties": {
          "title": {"type": "string", "minLength": 1, "maxLength": 160},
          "goal": {"type": "string", "minLength": 1, "maxLength": 1000},
          "deadline": {"type": "string", "format": "date"},
          "buffer_ratio": {"type": "number", "minimum": 0.2, "maximum": 0.8},
          "steps": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["ref", "title", "estimate_min", "estimate_max", "depends_on"],
              "properties": {
                "ref": {"type": "string", "minLength": 1},
                "title": {"type": "string", "minLength": 1, "maxLength": 160},
                "estimate_min": {"type": "integer", "minimum": 1},
                "estimate_max": {"type": "integer", "minimum": 1},
                "priority": {"type": "string", "enum": ["CRITICAL", "NORMAL", "OPTIONAL"]},
                "depends_on": {
                  "type": "array",
                  "items": {"type": "string"},
                  "uniqueItems": true
                }
              }
            }
          }
        }
      }
    }
  },
