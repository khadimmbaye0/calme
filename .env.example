# Copy to .env locally. Never put real values in Git.
# Docker Compose requires POSTGRES_PASSWORD; choose a local-only value.
POSTGRES_DB=calme
POSTGRES_USER=calme
POSTGRES_PASSWORD=replace-locally
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/calme
SPRING_DATASOURCE_USERNAME=calme
# The backend reuses the same value, locally and in Docker Compose.
SPRING_DATASOURCE_PASSWORD=${POSTGRES_PASSWORD}

# Optional host ports (defaults shown).
# DB_PORT=5432
# BACKEND_PORT=8080
# FRONTEND_PORT=5173

DEEPSEEK_API_KEY=
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
