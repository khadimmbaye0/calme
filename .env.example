# Copier vers .env localement. Ne jamais mettre de vraie valeur dans Git.
# ./scripts/up.sh génère POSTGRES_PASSWORD et CALME_AUTH_PASSWORD si besoin.
POSTGRES_DB=calme
POSTGRES_USER=calme
POSTGRES_PASSWORD=replace-locally
# Mot de passe du compte local Calme (généré par ./scripts/up.sh).
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/calme
SPRING_DATASOURCE_USERNAME=calme
# Le backend local réutilise le mot de passe PostgreSQL.
SPRING_DATASOURCE_PASSWORD=${POSTGRES_PASSWORD}

# Port publié de l'interface (5173 par défaut).
# FRONTEND_PORT=5173
# Port PostgreSQL local pour le développement (compose.dev.yaml).
# DB_PORT=5432

# Clé DeepSeek pour l'agent (optionnelle, jamais commitée).
DEEPSEEK_API_KEY=
# Modèle et mode de l'agent (simulé par défaut).
# DEEPSEEK_MODEL=deepseek-flash
# CALME_LLM_MODE=simulated

MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
